## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio Code history
*.code-workspace

## Ignore files created by JetBrains Rider
.idea/
*.sln.iml

# MSTest test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Visual Studio cache files
*.cache
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Ignore environment files with sensitive data
.env
.env.local
.env.*.local

# Ignore connection strings and secrets
*.pfx
*.cer

# Ignore test coverage results
*.coverage
*.coveragexml
coverage.opencover.xml
*.coverlet.*
coverage.json
coverage.cobertura.xml
[Tt]est[Rr]esults/

# Ignore Application Insights
ApplicationInsights.config

# Ignore Azure files
*.publishsettings
*.pubxml
*.pubxml.user

# Ignore Mac files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore Linux files
*~

# Ignore Docker files (if you want to keep them local)
# .dockerignore
# docker-compose.yml
# Dockerfile

# Ignore logs
*.log
Logs/
logs/

# Ignore database files (if using local SQLite)
*.mdf
*.ldf
*.db
*.sqlite
*.sqlite3

# Ignore backup files
*.bak
*.backup
*.backup~

# Ignore temporary files
*.swp
*.swo
*~
$RECYCLE.BIN/

# Ignore compression files
*.zip
*.tar
*.tar.gz
*.rar

# Ignore documentation (optional - uncomment if needed)
# *.md
# !README.md

# Ignore IDE specific files
*.sublime-project
*.sublime-workspace

# Ignore Sentry files
.sentryclirc

# Ignore crash reports
crashpad_*.txt

# Ignore Entity Framework Core scaffolding
ScaffoldingReadMe.txt

# Ignore OpenAPI generated files (if enabled)
swagger.json
openapi.json

# Ignore performance profiles
*.perf
*.etl
*.eti
*.spc
*.xml

# Node modules (if you have any frontend tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ASP.NET Core Data Protection keys
DataProtection-Keys/

# Ignore SSL certificates
*.p12
*.pem

# Ignore temporary ASP.NET files
aspnetcore/
ASP.NET/

# Ignore compiled Razor views
*.RazorCompileOnBuild.cache
*.RazorCompileOnPublish.cache

# Ignore .NET Core diagnostic files
*.diagnostics.json

# Ignore ML.NET model files
*.zip
*.mlnet

# Ignore BenchmarkDotNet results
BenchmarkDotNet.Artifacts/

# Ignore JetBrains Rider test runner data
.rider/

# Ignore test explorer state
TestExplorer/
